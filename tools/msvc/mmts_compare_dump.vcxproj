    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- thirdparty/tsduck root, relative to this project file -->
    <TSDuckRootDir>$(MSBuildThisFileDirectory)..\..\..\dantto4k\thirdparty\tsduck\</TSDuckRootDir>
    <TSDuckStaticLibDir Condition="'$(Configuration)'=='Release'">$(TSDuckRootDir)bin\Release-x64\</TSDuckStaticLibDir>
    <TSDuckStaticLibDir Condition="'$(Configuration)'=='Debug'">$(TSDuckRootDir)bin\Debug-x64\</TSDuckStaticLibDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same recursive header enumeration dantto4k's own tsduck-static.props uses -->
    <_TSCorePublicHeaders Include="$(TSDuckRootDir)src\libtscore\**\*.h"
                          Exclude="$(TSDuckRootDir)src\libtscore\**\unix\**;
                                   $(TSDuckRootDir)src\libtscore\**\linux\**;
                                   $(TSDuckRootDir)src\libtscore\**\mac\**;
                                   $(TSDuckRootDir)src\libtscore\**\bsd\**;
                                   $(TSDuckRootDir)src\libtscore\**\private\**;
                                   $(TSDuckRootDir)src\libtscore\**\__pycache__\**" />
    <_TSDuckPublicHeaders Include="$(TSDuckRootDir)src\libtsduck\**\*.h"
                          Exclude="$(TSDuckRootDir)src\libtsduck\**\unix\**;
                                   $(TSDuckRootDir)src\libtsduck\**\linux\**;
                                   $(TSDuckRootDir)src\libtsduck\**\mac\**;
                                   $(TSDuckRootDir)src\libtsduck\**\bsd\**;
                                   $(TSDuckRootDir)src\libtsduck\**\private\**;
                                   $(TSDuckRootDir)src\libtsduck\**\__pycache__\**" />
    <_TSCorePublicDirs Include="@(_TSCorePublicHeaders->'%(RootDir)%(Directory)'->Distinct())" />
    <_TSDuckPublicDirs Include="@(_TSDuckPublicHeaders->'%(RootDir)%(Directory)'->Distinct())" />
  </ItemGroup>
  <PropertyGroup>
    <TSCoreIncludeDirs>@(_TSCorePublicDirs)</TSCoreIncludeDirs>
    <TSDuckIncludeDirs>@(_TSDuckPublicDirs)</TSDuckIncludeDirs>
  </PropertyGroup>

  <!-- ==================== Common settings ==================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>
        ..;
        ..\..\src;
        ..\..\..\dantto4k\src;
        $(TSCoreIncludeDirs);
        $(TSDuckIncludeDirs);
        $(TSDuckRootDir)bin\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        WIN32;_CONSOLE;TSDUCK_STATIC_LIBRARY;TSCORE_STATIC_LIBRARY;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /permissive /wd4819 /Wv:17 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>
        $(TSDuckStaticLibDir);
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        ws2_32.lib;
        tsducklib.lib;tscorelib.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
      <AdditionalOptions>/wholearchive:tsducklib.lib /wholearchive:tscorelib.lib %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <!-- ==================== Debug ==================== -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- ==================== Release ==================== -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
    </ClCompile>
  </ItemDefinitionGroup>

