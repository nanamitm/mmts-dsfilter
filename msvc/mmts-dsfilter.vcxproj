  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetName>mmts-dsfilter</TargetName>
    <TargetExt>.ax</TargetExt>
  </PropertyGroup>

  <!-- ==================== Common settings ==================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>
        ..\src;
        ..\baseclasses\Samples\Win7Samples\multimedia\directshow\baseclasses;
        ..\..\dantto4k\src;
        ..\..\dantto4k\thirdparty\asio\asio\include;
        C:\vcpkg\packages\ffmpeg_x64-windows\include;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        WIN32;_WINDOWS;_USRDLL;UNICODE;_UNICODE;NODDRAW;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <!-- Suppress warnings from BaseClasses (old code) -->
      <DisableSpecificWarnings>4996;4244;4267;4800;4018;4312;4311;4302;4596;4099</DisableSpecificWarnings>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- /permissive needed for old BaseClasses code (qualified dtor names, etc.) -->
      <AdditionalOptions>/utf-8 /permissive %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <ModuleDefinitionFile>..\msvc\mmts-dsfilter.def</ModuleDefinitionFile>
      <AdditionalLibraryDirectories>
        C:\vcpkg\packages\ffmpeg_x64-windows\lib;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <AdditionalDependencies>
        strmiids.lib;winmm.lib;ole32.lib;oleaut32.lib;uuid.lib;
        Winscard.lib;ws2_32.lib;
        avcodec.lib;avutil.lib;swresample.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <!-- Match the SONAME by wildcard: vcpkg bumps ffmpeg (and with it
           avcodec-NN / avutil-NN / swresample-N) without notice, and a
           hard-coded number turns that into a post-build failure. -->
      <Command>copy /Y C:\vcpkg\packages\ffmpeg_x64-windows\bin\avcodec-*.dll "$(OutDir)"
copy /Y C:\vcpkg\packages\ffmpeg_x64-windows\bin\avutil-*.dll "$(OutDir)"
copy /Y C:\vcpkg\packages\ffmpeg_x64-windows\bin\swresample-*.dll "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>

  <!-- ==================== Debug ==================== -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
      <PreprocessorDefinitions>DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <OutputFile>$(TargetPath)</OutputFile>
    </Link>
  </ItemDefinitionGroup>

  <!-- ==================== Release ==================== -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
    </ClCompile>
    <Link>
      <OutputFile>$(TargetPath)</OutputFile>
    </Link>
  </ItemDefinitionGroup>

