// The version this build comes from (git describe), shown in the file's
// properties. tools/generate-version-header.ps1 writes the header from a
// pre-build step, the way TVTest's TVTestVersionHashGen.bat does.
#include <winver.h>
#include "../src/MmtsDsfilterVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MMTS_DSFILTER_VERSION_NUMBERS
 PRODUCTVERSION MMTS_DSFILTER_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "mmts-dsfilter (MMT/TLV DirectShow source filter)"
            VALUE "FileVersion", MMTS_DSFILTER_VERSION_STRING
            VALUE "ProductName", "mmts-dsfilter"
            VALUE "ProductVersion", MMTS_DSFILTER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
